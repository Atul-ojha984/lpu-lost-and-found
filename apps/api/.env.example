# ==============================================================================
# LPU Lost & Found Property Recovery Platform — API Environment Template
# Placeholder values only. Never commit real credentials or secret keys.
# ==============================================================================

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Local development default. For Atlas, replace with the connection string copied
# from Atlas > Connect > Drivers. Keep the URI in your hosting provider's secret
# environment settings; do not commit it to Git.
MONGODB_URI=mongodb://127.0.0.1:27017/lpu_lost_found
MONGODB_DATABASE=lpu_lost_found

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_random_cookie_secret_at_least_32_characters

# 32-byte hex key for AES-256-GCM. Preserve the existing key for existing encrypted data.
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RETENTION_PERIOD_DAYS=90
OTP_EXPIRY_MINUTES=15
