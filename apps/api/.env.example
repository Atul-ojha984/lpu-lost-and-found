# ==============================================================================
# LPU Lost & Found Property Recovery Platform — API Environment Template
# Note: Contain only placeholder values. Never commit actual secret keys or credentials.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# MongoDB Database Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Local fallback: mongodb://127.0.0.1:27017/lpu_lost_found
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@cluster0.mongodb.net/lpu_lost_found?retryWrites=true&w=majority
MONGODB_DATABASE=lpu_lost_found

# Authentication & Sessions
# Generate secure keys using: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_at_least_32_characters_long_random_seed
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_random_32_bytes_long

# Cryptographic Field-Level Encryption (Private Identifying Vault)
# Must be a 32-byte hex string (exactly 64 hex characters) for AES-256-GCM.
# Generate in Node via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Campus Operational Lifecycle Rules
RETENTION_PERIOD_DAYS=90
OTP_EXPIRY_MINUTES=15
