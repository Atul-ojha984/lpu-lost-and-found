# ==============================================================================
# LPU Lost & Found Property Recovery Platform
# Django REST Framework Backend Environment Template
# ==============================================================================

# Django Core Settings
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=django-insecure-replace-with-a-random-50-character-secret-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Local development may use the explicit SQLite URL below. Production requires
# DATABASE_URL to be set in Render to the existing PostgreSQL Internal Database URL.
# Never put the real Render URL or database credentials in this file or Git.
# External PostgreSQL connections should include sslmode=require; Render internal
# connections in the same region can use the supplied internal URL as-is.
DATABASE_URL=sqlite:///db.sqlite3

# CORS & CSRF Origins (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production HTTPS & Cookie Security (Set to True in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Authentication & JWT
JWT_SIGNING_KEY=django-jwt-dev-secret-minimum-32-chars-long!
JWT_ACCESS_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# AES-256 Field Encryption Key (64 hex characters or base64-encoded 32 bytes)
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Media & Storage Settings
MEDIA_ROOT=media/
PRIVATE_EVIDENCE_ROOT=private_evidence/
STATIC_ROOT=staticfiles/
