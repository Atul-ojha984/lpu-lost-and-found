# Sanitized template for local MongoDB-backend development only.
# Never place real Atlas credentials, production secrets, or production database
# names in this file. Set production values through a secret manager/dashboard.
DJANGO_SETTINGS_MODULE=config.settings_mongodb
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-local-only-random-secret
JWT_SIGNING_KEY=replace-with-a-separate-local-only-random-secret
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=lpu_lost_found_local
MEDIA_ROOT=media/
PRIVATE_EVIDENCE_ROOT=private_evidence/
